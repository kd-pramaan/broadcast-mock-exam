# Postgres connection string (Neon/Supabase free tier both work)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Any random 32+ character string, used to encrypt the login session cookie
SESSION_SECRET="replace-with-a-random-32-plus-character-string"

# Optional: leave blank in dev. Without it, verification/activation emails are
# just logged to the server console instead of sent, so you can click the link yourself.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Used to build the verification link. Set to your real Vercel URL in production.
APP_URL="http://localhost:3000"

# Used once by `npm run seed` to create the first admin account.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"
