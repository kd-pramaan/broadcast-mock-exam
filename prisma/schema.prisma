generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// status: account state, always "active" from registration onward today -
// kept as a field for a future suspend/ban use, not currently set otherwise.
// plan: basic -> pending_approval -> paid. Registration starts everyone on
// "basic" (free papers only); submitting a payment reference moves them to
// "pending_approval"; an admin confirming it moves them to "paid" (all papers).
model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  age              Int
  region           String
  passwordHash     String?
  status           String    @default("active")
  plan             String    @default("basic")
  verifyToken      String?   @unique // only used by forgot/reset-password today
  paymentReference String?
  isAdmin          Boolean   @default(false)
  createdAt        DateTime  @default(now())
  attempts         Attempt[]
}

model Exam {
  id              String    @id @default(cuid())
  title           String
  description     String?
  tags            String[]  @default([])
  // type: "short" (single subject paper, questions in `questions`) or "full"
  // (multi-paper exam, paper definitions in `papers`).
  type            String    @default("short")
  // short exam: whole-exam time limit. full exam: total across the active
  // papers (informational; each paper enforces its own timer).
  durationMinutes Int
  // short exam questions: [{ id, text, topic, options: string[], correctIndex, marks, explanation }].
  // full exam: empty array, questions live inside each entry of `papers`.
  questions       Json      @default("[]")
  // full exam papers: [{ key, title, durationMinutes, questions, group?, selector? }].
  // Papers sharing a `group` (e.g. "paper2") are alternatives; the user picks one
  // via `selector` ("radio" / "tv") before the attempt starts.
  papers          Json?
  totalMarks      Int
  isPublished     Boolean   @default(true)
  isFree          Boolean   @default(false) // included in the Basic (free) plan
  createdAt       DateTime  @default(now())
  attempts        Attempt[]
}

// Submissions from the public "Contact us" form. The app never emails
// these out - an admin reads them here and replies by hand using the
// captured email address.
model ContactMessage {
  id        String   @id @default(cuid())
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Attempt {
  id            String    @id @default(cuid())
  userId        String
  examId        String
  attemptNumber Int
  answers       Json?     // { [questionId]: selectedOptionIndex }
  // full exams only: which paper-2 stream the user picked ("radio" | "tv").
  paperChoice   String?
  // full exams only: per-paper score breakdowns, e.g.
  // [{ key, title, totalMarks, correctCount, wrongCount, skippedCount, marksEarned, penalty, score }].
  paperScores   Json?
  score         Float?    // can go negative / fractional: 1/4 negative marking on wrong answers
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  user          User      @relation(fields: [userId], references: [id])
  exam          Exam      @relation(fields: [examId], references: [id])

  @@unique([userId, examId, attemptNumber])
}
